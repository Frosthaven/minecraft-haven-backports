{
  "pools": [
    {
      "match": [
        "minecraft:item minecraft:map"
      ],
      "change": [
        {
          "from": {
            "functions": [
              {
                "decoration": "minecraft:red_x",
                "function": "minecraft:exploration_map",
                "skip_existing_chunks": false,
                "zoom": 1
              },
              {
                "function": "minecraft:set_name",
                "name": {
                  "translate": "filled_map.buried_treasure"
                },
                "target": "item_name"
              }
            ],
            "name": "minecraft:map",
            "type": "minecraft:item"
          },
          "to": {
            "functions": [
              {
                "decoration": "minecraft:red_x",
                "destination": "#minecraft:on_treasure_maps",
                "function": "haven_backports:exploration_map",
                "skip_existing_chunks": false,
                "zoom": 1
              },
              {
                "function": "haven_backports:filtered",
                "item_filter": {
                  "predicates": {
                    "haven_backports:map_id": {}
                  }
                },
                "on_fail": {
                  "function": "haven_backports:discard"
                }
              }
            ],
            "name": "haven_backports:buried_treasure_map",
            "type": "minecraft:item"
          }
        }
      ]
    },
    {
      "match": [
        "minecraft:item minecraft:book",
        "minecraft:item minecraft:clock",
        "minecraft:item minecraft:compass",
        "minecraft:item minecraft:feather",
        "minecraft:item minecraft:map",
        "minecraft:item minecraft:paper"
      ]
    },
    {
      "match": [
        "minecraft:empty ",
        "minecraft:item minecraft:coast_armor_trim_smithing_template"
      ]
    }
  ],
  "add_pools": [
    {
      "after": 2,
      "pool": {
        "entries": [
          {
            "type": "minecraft:empty",
            "weight": 148
          },
          {
            "functions": [
              {
                "count": 1,
                "function": "minecraft:set_count"
              }
            ],
            "name": "haven_backports:copper_nautilus_armor",
            "type": "minecraft:item",
            "weight": 20
          },
          {
            "functions": [
              {
                "count": 1,
                "function": "minecraft:set_count"
              }
            ],
            "name": "haven_backports:iron_nautilus_armor",
            "type": "minecraft:item",
            "weight": 10
          },
          {
            "functions": [
              {
                "count": 1,
                "function": "minecraft:set_count"
              }
            ],
            "name": "haven_backports:golden_nautilus_armor",
            "type": "minecraft:item",
            "weight": 5
          },
          {
            "functions": [
              {
                "count": 1,
                "function": "minecraft:set_count"
              }
            ],
            "name": "haven_backports:diamond_nautilus_armor",
            "type": "minecraft:item",
            "weight": 2
          }
        ],
        "rolls": 1
      }
    }
  ]
}
